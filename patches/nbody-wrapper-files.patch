+/* The pinned checkpoint header stores these arrays as raw process pointers.
+ * Wrapper restarts have the identical Lua input available; rebuild only its
+ * context arrays, never the checkpoint bodies or simulation step. */
+int nbRestoreWrapperSoftening(NBodyCtx* ctx, NBodyState* st, const NBodyFlags* nbf)
+{
+    NBodyCtx fresh = EMPTY_NBODYCTX;
+    lua_State* luaSt = nbOpenLuaStateWithScript(nbf, NULL);
+    if (!luaSt) return 1;
+    int rc = nbEvaluateContext(luaSt, &fresh);
+    lua_close(luaSt);
+    if (rc || fresh.eps2_size != ctx->eps2_size) return 1;
+    ctx->eps2 = fresh.eps2;
+    ctx->eps2_index = fresh.eps2_index;
+    nbCacheEps2Indices(ctx, st);
+    return 0;
+}
