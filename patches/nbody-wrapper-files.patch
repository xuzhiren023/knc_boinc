     mw_fraction_done(frac);
+    /* Opt in: ordinary standalone users do not acquire side files. */
+    if (getenv("KNC_WRAPPER_FILES"))
+        kncPublish("progress", "progress.tmp", (double) frac);

     if (st->reportProgress)
     {
