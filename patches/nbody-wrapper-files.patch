+/* Standalone wrapper file protocol. Called only at safe simulation steps. */
+static int kncPublish(const char* path, const char* tmp, double value)
+{
+    FILE* f = fopen(tmp, "w");
+    if (!f) return 1;
+    if (fprintf(f, "%.17g\n", value) < 0) { fclose(f); return 1; }
+    if (fclose(f)) return 1;
+    return rename(tmp, path) != 0;
+}
