+/* Standalone wrapper file protocol. Called only at safe simulation steps. */
+static int kncPublish(const char* path, const char* tmp, double value)
+{
+    FILE* f = fopen(tmp, "w");
+    if (!f) return 1;
+    if (fprintf(f, "%.17g\n", value) < 0) { fclose(f); return 1; }
+    if (fclose(f)) return 1;
+    return rename(tmp, path) != 0;
+}
+
+#include "knc_graphics_format.h"
+#include <time.h>
+/* CLI storage lives in main.c; disabled means no clock calls or side files. */
+extern double kncSnapshotInterval;
+static void kncSnapshot(const NBodyCtx* ctx, const NBodyState* st)
+{
+    static double last = -1, cost = 0;
+    static unsigned int writes = 0;
+    static knc_snapshot frame;
+    struct timespec ts;
+    double now;
+    uint32_t i, count;
+    FILE* f;
+    if (kncSnapshotInterval <= 0) return;
+    if (clock_gettime(CLOCK_MONOTONIC, &ts)) return;
+    now = ts.tv_sec + ts.tv_nsec * 1e-9;
+    if (last >= 0 && now-last < kncSnapshotInterval && st->step < ctx->nStep) {
+        if (!clock_gettime(CLOCK_MONOTONIC, &ts)) cost += ts.tv_sec + ts.tv_nsec * 1e-9 - now;
+        return;
+    }
+    last = now;
+    memset(&frame, 0, sizeof(frame));
+    frame.magic = KNC_SNAPSHOT_MAGIC;
+    frame.version = KNC_GRAPHICS_VERSION;
+    frame.size = sizeof(frame);
+    count = st->nbody < 4096 ? st->nbody : 4096; /* deterministic subsample */
+    frame.body_count = count;
+    frame.step = st->step;
+    frame.sim_time = st->step * ctx->timestep;
+    frame.fraction_done = ctx->nStep ? (double)st->step / ctx->nStep : 1;
+    for (i=0; i<count; ++i) {
+        const Body* b = &st->bodytab[(uint64_t)i * st->nbody / count];
+        frame.bodies[i].x = X(Pos(b));
+        frame.bodies[i].y = Y(Pos(b));
+        frame.bodies[i].z = Z(Pos(b));
+        frame.bodies[i].type = Type(b) < 0 ? KNC_DARK : KNC_LIGHT;
+    }
+    f = fopen("snapshot.tmp", "wb");
+    if (!f) return;
+    { int ok = fwrite(&frame, 1, sizeof(frame), f) == sizeof(frame);
+      if (fclose(f)) ok = 0;
+      if (ok) { if (!rename("snapshot.tmp", "snapshot")) ++writes; }
+      else remove("snapshot.tmp"); }
+    if (!clock_gettime(CLOCK_MONOTONIC, &ts)) cost += ts.tv_sec + ts.tv_nsec * 1e-9 - now;
+    if (st->step >= ctx->nStep)
+        fprintf(stderr, "KNC snapshot writes=%u cost_seconds=%.9f%c", writes, cost, 10);
+}
