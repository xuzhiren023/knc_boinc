+#if NBODY_DF_REUSE
+/* Restrict reuse to initialized, read-only dispatches. Other profiles retain
+ * their original calls (including warnings and lazy initialization). */
+static int df_reuse_ready(const Dwarf* m)
+{
+    return m->type == Plummer || m->type == General_Hernquist ||
+           ((m->type == Cored || m->type == NFW) && m->p0 != 0.0);
+}
+
+typedef struct { real first, second, center; } DfDerivatives;
+static DfDerivatives df_derivatives(real (*func)(const Dwarf*, real),
+                                    real x, const Dwarf* model)
+{
+    const real h = 0.001;
+    real mm = (*func)(model, x - 2.0 * h);
+    real m  = (*func)(model, x - h);
+    real pp = (*func)(model, x + 2.0 * h);
+    real p  = (*func)(model, x + h);
+    real c  = (*func)(model, x);
+    DfDerivatives d;
+    /* Keep upstream's coefficient, addition and reciprocal order verbatim. */
+    real p1 = 1.0 * mm, p2 = -8.0 * m, p3 = -1.0 * pp, p4 = 8.0 * p;
+    real denom = inv(12.0 * h);
+    d.first = (p1 + p2 + p3 + p4) * denom;
+    p1 = -1.0 * pp; p2 = 16.0 * p; p3 = -30.0 * c;
+    p4 = 16.0 * m;
+    real p5 = -1.0 * mm;
+    denom = inv(12.0 * h * h);
+    d.second = (p1 + p2 + p3 + p4 + p5) * denom;
+    d.center = c;
+    return d;
+}
+#endif
 
