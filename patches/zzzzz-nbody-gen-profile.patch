+++ b/nbody/include/nbody_gen_profile.h
@@ -0,0 +1,108 @@
+/* S10-03 instrumentation only. All hooks compile away unless selected. */
+#ifndef NBODY_GEN_PROFILE_H
+#define NBODY_GEN_PROFILE_H
+#ifndef NBODY_GEN_PROFILE
+#define NBODY_GEN_PROFILE 0
+#endif
+#if NBODY_GEN_PROFILE
+#include <omp.h>
+#include <stdio.h>
+#include <string.h>
+#include <limits.h>
+enum { GP_body, GP_nodes, GP_quad_serial, GP_dist_serial, GP_max,
+       GP_rejection, GP_radius, GP_rng, GP_components, GP_N };
+static const char* const gp_names[GP_N] = {
+    "body", "nodes", "quad_serial", "dist_serial", "max", "rejection",
+    "radius", "rng", "components"
+};
+static struct {
+    double exclusive[GP_N], inclusive[GP_N], stamp;
+    int stack[16], depth;
+    unsigned long long integrals, velocity_attempts, radius_attempts, rng_calls;
+    unsigned long long before[3], minimum[3], maximum[3];
+} gp;
+/* Hooks run on the serial generator caller, never on node workers. */
+static void gp_enter(int phase)
+{
+    double now = omp_get_wtime();
+    if (gp.depth) gp.exclusive[gp.stack[gp.depth-1]] += now - gp.stamp;
+    gp.stack[gp.depth++] = phase;
+    gp.inclusive[phase] -= now;
+    gp.stamp = now;
+}
+static void gp_leave(void)
+{
+    double now = omp_get_wtime();
+    int phase = gp.stack[--gp.depth];
+    gp.exclusive[phase] += now - gp.stamp;
+    gp.inclusive[phase] += now;
+    gp.stamp = now;
+}
+static void gp_reset(void)
+{
+    int j;
+    memset(&gp, 0, sizeof(gp));
+    for (j=0; j<3; ++j) gp.minimum[j] = ULLONG_MAX;
+}
+static void gp_body_start(void)
+{
+    gp.before[0]=gp.integrals;
+    gp.before[1]=gp.velocity_attempts;
+    gp.before[2]=gp.radius_attempts;
+}
+static void gp_body_end(void)
+{
+    unsigned long long counts[3] = {gp.integrals,gp.velocity_attempts,gp.radius_attempts};
+    int j;
+    for (j=0; j<3; ++j) {
+        unsigned long long n=counts[j]-gp.before[j];
+        if (n<gp.minimum[j]) gp.minimum[j]=n;
+        if (n>gp.maximum[j]) gp.maximum[j]=n;
+    }
+}
+static real gp_random(dsfmt_t* state, real lo, real hi)
+{
+    gp_enter(GP_rng);
+    ++gp.rng_calls;
+    real value = mwXrandom(state, lo, hi);
+    gp_leave();
+    return value;
+}
+static mwvector gp_unitpoint(dsfmt_t* state)
+{
+    gp_enter(GP_rng);
+    gp.rng_calls += 3; /* mwRandomUnitPoint consumes exactly NDIM=3 draws. */
+    mwvector value = mwRandomUnitPoint(state);
+    gp_leave();
+    return value;
+}
+static void gp_report(unsigned int bodies)
+{
+    int j;
+    fprintf(stderr,"GEN_PROFILE bodies=%u integrals=%llu velocity_attempts=%llu radius_attempts=%llu rng_calls=%llu total_seconds=%.9f\n",
+            bodies,gp.integrals,gp.velocity_attempts,gp.radius_attempts,gp.rng_calls,gp.inclusive[GP_body]);
+    for(j=0;j<GP_N;++j)
+        fprintf(stderr,"GEN_PHASE %s exclusive=%.9f inclusive=%.9f\n",gp_names[j],gp.exclusive[j],gp.inclusive[j]);
+    for(j=0;j<3;++j)
+        fprintf(stderr,"GEN_PER_BODY %s min=%llu max=%llu\n",
+                j==0?"integrals":j==1?"velocity_attempts":"radius_attempts",gp.minimum[j],gp.maximum[j]);
+}
+#define GP_BEGIN(name) gp_enter(GP_##name)
+#define GP_END() gp_leave()
+#define GP_COUNT(name) (++gp.name)
+#define GP_RESET() gp_reset()
+#define GP_BODY_START() gp_body_start()
+#define GP_BODY_END() gp_body_end()
+#define GP_REPORT(n) gp_report(n)
+#else
+#define GP_BEGIN(name) ((void)0)
+#define GP_END() ((void)0)
+#define GP_COUNT(name) ((void)0)
+#define GP_RESET() ((void)0)
+#define GP_BODY_START() ((void)0)
+#define GP_BODY_END() ((void)0)
+#define GP_REPORT(n) ((void)0)
+#define gp_random mwXrandom
+#define gp_unitpoint mwRandomUnitPoint
+#endif
+#endif
