+/* D=3 gives up to 512 jobs for 240 card threads, with only 73 serial
+ * internal cells. Stable partitioning retains insertion order in each job.
+ * A lone body is attached directly; only collisions create top cells. */
+typedef struct
+{
+    NBodyCell* cell;
+    Body** bodies;
+    int count;
+    real size;
+} NBTreeBucket;
+
+
+/* The top levels are constructed from contiguous ranges of one stable
+ * counting sort. Keys use the same repeated midpoint arithmetic as insertion. */
+static void nbTopCells(NBodyState* st, NBodyCell* cell, real size,
+                       unsigned depth, Body** bodies, int firstKey, int span,
+                       const int* offsets, NBTreeBucket* buckets, int* used)
+{
+    int oct;
+    if (depth == NB_TREE_DEPTH) {
+        NBTreeBucket* b = &buckets[(*used)++];
+        b->cell = cell; b->size = size;
+        b->bodies = bodies + offsets[firstKey];
+        b->count = offsets[firstKey + span] - offsets[firstKey];
+        return;
+    }
+    span /= NSUB;
+    for (oct = 0; oct < NSUB; ++oct) {
+        int key = firstKey + oct * span;
+        int begin = offsets[key], count = offsets[key + span] - begin;
+        if (count == 1) {
+            Subp(cell)[oct] = (NBodyNode*) bodies[begin];
+            st->tree.maxDepth = MAX(st->tree.maxDepth, depth);
+        } else if (count > 1) {
+            NBodyCell* child = nbMakeCell(st, &st->tree);
+            nbInitMidpoint(child, bodies[begin], cell, size);
+            Subp(cell)[oct] = (NBodyNode*) child;
+            nbTopCells(st, child, size * 0.5, depth + 1, bodies,
+                       key, span, offsets, buckets, used);
+        }
+    }
+}
+
+static void nbCollectFrontier(NBodyCell* cell, real size, int depth,
+                               NBTreeBucket* buckets, int* used)
+{
+    int oct;
+    if (depth == NB_TREE_DEPTH) {
+        buckets[*used].cell = cell; buckets[(*used)++].size = size;
+        return;
+    }
+    for (oct = 0; oct < NSUB; ++oct)
+        if (Subp(cell)[oct] && isCell(Subp(cell)[oct]))
+            nbCollectFrontier((NBodyCell*) Subp(cell)[oct], size * 0.5,
+                              depth + 1, buckets, used);
+}
+
+static void nbPoolPartition(NBodyState* st, NBTreeBucket* buckets, int* used)
+{
+    NBTreePool* pool = st->treePool;
+    int counts[NB_TREE_BUCKETS] = {0}, offsets[NB_TREE_BUCKETS+1], next[NB_TREE_BUCKETS];
+    int i;
+#ifdef _OPENMP
+    #pragma omp parallel for schedule(static)
+#endif
+    for (i = 0; i < st->nbody; ++i) {
+        Body* body = st->bodytab + i;
+        NBodyCell mid;
+        real size = st->tree.rsize;
+        int d, key = 0;
+        mw_zerov(Pos(&mid));
+        for (d = 0; d < NB_TREE_DEPTH; ++d) {
+            int oct = nbSubIndex(body, &mid);
+            key = key * NSUB + oct;
+            nbInitMidpoint(&mid, body, &mid, size);
+            size *= 0.5;
+        }
+        pool->keys[i] = Mass(body) != 0.0 ? key : NB_TREE_BUCKETS;
+    }
+    for (i = 0; i < st->nbody; ++i)
+        if (pool->keys[i] < NB_TREE_BUCKETS) ++counts[pool->keys[i]];
+    offsets[0] = 0;
+    for (i = 0; i < NB_TREE_BUCKETS; ++i) {
+        next[i] = offsets[i]; offsets[i+1] = offsets[i] + counts[i];
+    }
+    for (i = 0; i < st->nbody; ++i)
+        if (pool->keys[i] < NB_TREE_BUCKETS)
+            pool->bodies[next[pool->keys[i]]++] = st->bodytab + i;
+    nbTopCells(st, st->tree.root, st->tree.rsize, 0, pool->bodies,
+               0, NB_TREE_BUCKETS, offsets, buckets, used);
+}
+
+static void nbPoolInsert(NBodyState* st, NBTreeBucket* buckets, int used)
+{
+    NBTreePool* pool = st->treePool;
+    int i;
+    for (i = 0; i < pool->threads; ++i) {
+        NBodyState* w = pool->workers + i;
+        /* Worker state is aligned and private; no free-list construction. */
+        w->tree = st->tree; w->tree.cellUsed = 0; w->tree.maxDepth = 0;
+        w->treePool = pool; w->treePoolNext = w->treePoolEnd = 0;
+    }
+#ifdef _OPENMP
+    #pragma omp parallel
+#endif
+    {
+        int id = 0, j, k;
+#ifdef _OPENMP
+        id = omp_get_thread_num();
+        #pragma omp for schedule(dynamic, 1)
+#endif
+        for (j = 0; j < used; ++j) {
+            NBTreeBucket* b = buckets + j;
+            for (k = 0; k < b->count; ++k)
+                nbLoadBodyFrom(pool->workers + id, &pool->workers[id].tree,
+                               b->bodies[k], b->cell, b->size, NB_TREE_DEPTH);
+        }
+    }
+    for (i = 0; i < pool->threads; ++i) {
+        st->tree.cellUsed += pool->workers[i].tree.cellUsed;
+        st->tree.maxDepth = MAX(st->tree.maxDepth, pool->workers[i].tree.maxDepth);
+        st->tree.structureError |= pool->workers[i].tree.structureError;
+    }
+}
+
+static void nbMoments(const NBodyCtx* ctx, NBodyTree* t, NBTreeBucket* buckets, int used, int parallel)
+{
+    int i, error = 0;
+    if (!parallel) { hackCofMTo(ctx, t, t->root, t->rsize, -1); return; }
+#ifdef _OPENMP
+    #pragma omp parallel for schedule(dynamic, 1) reduction(|:error)
+#endif
+    for (i = 0; i < used; ++i) {
+        NBodyTree local = *t;
+        hackCofMTo(ctx, &local, buckets[i].cell, buckets[i].size, -1);
+        error |= local.structureError;
+    }
+    t->structureError |= error;
+    hackCofMTo(ctx, t, t->root, t->rsize, NB_TREE_DEPTH - 1);
+}
+
+static void nbQuads(NBodyTree* t, NBTreeBucket* buckets, int used, int parallel)
+{
+    int i;
+    if (!parallel) { hackQuadTo(t->root, -1); return; }
+#ifdef _OPENMP
+    #pragma omp parallel for schedule(dynamic, 1)
+#endif
+    for (i = 0; i < used; ++i) hackQuadTo(buckets[i].cell, -1);
+    hackQuadTo(t->root, NB_TREE_DEPTH - 1);
+}
+
+static NBodyStatus nbBuildTree(const NBodyCtx* ctx, NBodyState* st, int parallel)
+{
+    Body* p;
+    NBodyTree* t = &st->tree;
+    NBTreeBucket buckets[NB_TREE_BUCKETS];
+    int used = 0, pool = parallel && NBODY_TREE_VARIANT == 2;
+    if (pool && !st->treePool) {
