+        };
+        if (parallel) nbCollectFrontier(t->root, t->rsize, 0, buckets, &used);
+    }
+    if (t->structureError) return NBODY_TREE_STRUCTURE_ERROR;
+    nbMoments(ctx, t, buckets, used, parallel);
+    if (t->structureError) return NBODY_TREE_STRUCTURE_ERROR;
+    threadTree((NBodyNode*) t->root, NULL);
+    if (ctx->useQuad) nbQuads(t, buckets, used, parallel);
+    return NBODY_SUCCESS;
+}
