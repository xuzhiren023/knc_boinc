+/* Allocation routing for the arena and stable scratch. */
+static void* nbTreeAlloc(size_t bytes, int aligned)
+{
+    return aligned ? mwMallocA(bytes) : mwMalloc(bytes);
+}
+
+void nbReleaseTreePool(NBodyState* st)
+{
+    NBTreePool* pool = st->treePool;
+    if (!pool) return;
+    mwFreeA(pool->cells); free(pool->keys); free(pool->bodies);
+    mwFreeA(pool->workers); mwFreeA(pool);
+    st->treePool = NULL; st->tree.root = NULL; st->freeCell = NULL;
+}
+
+static void nbPoolPrepare(NBodyState* st)
+{
+    NBTreePool* p = st->treePool;
+    size_t levels = 1, capacity;
+    real size = st->tree.rsize;
+    int threads = 1;
+#ifdef _OPENMP
+    threads = omp_get_max_threads();
+#endif
+    /* Any insertion either creates a branching cell or traverses a unary
+     * chain. Charging every possible level to every body is a conservative
+     * bound, including the cell made immediately before epsilon rejection. */
+    while (size > REAL_EPSILON) { ++levels; size *= 0.5; }
+    capacity = 1 + (size_t) st->nbody * (levels + 1) +
+               (size_t) (threads + 1) * NB_SLAB;
+    if (capacity > p->capacity) {
+        mwFreeA(p->cells);
+        p->cells = nbTreeAlloc(capacity * sizeof(*p->cells), 1);
+        p->capacity = capacity;
+    }
+    if (p->nbody != st->nbody) {
+        free(p->keys); free(p->bodies);
+        p->keys = nbTreeAlloc(st->nbody * sizeof(*p->keys), 0);
+        p->bodies = nbTreeAlloc(st->nbody * sizeof(*p->bodies), 0);
+        p->nbody = st->nbody;
+    }
+    if (p->threads != threads) {
+        mwFreeA(p->workers);
+        p->workers = nbTreeAlloc(threads * sizeof(*p->workers), 1);
+        p->threads = threads;
+    }
+    /* expandBox used the persistent midpoint scratch root. From insertion
+     * onward every live cell, including the root, is in the same arena. */
+    p->cells[0] = p->root;
+    st->tree.root = p->cells;
+    p->cursor = 1;
+    st->treePoolNext = st->treePoolEnd = 0;
+}
+
 
