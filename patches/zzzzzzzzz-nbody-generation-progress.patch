 /*      DWARF GENERATION        */
+/* Instrumentation only: generation counts, no RNG or science state access. */
+static void kncGenerationProgress(unsigned done, unsigned total)
+{
+    FILE* f;
+    if (!getenv("KNC_WRAPPER_FILES") || (done && done != total && done % 64)) return;
+    f = fopen("generation.tmp", "w");
+    if (!f) return;
+    { int ok = fprintf(f, "%u %u%c", done, total, 10) > 0;
+      if (fclose(f)) ok = 0;
+      if (ok) rename("generation.tmp", "generation"); }
+}
