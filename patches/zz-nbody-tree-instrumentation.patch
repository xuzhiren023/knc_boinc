+static void nbShapeWalk(NBodyCell* p, unsigned char** out)
+{
+    int i;
+    unsigned char mask = 0;
+    for (i = 0; i < NSUB; ++i) if (Subp(p)[i]) mask |= 1u << i;
+    *(*out)++ = mask;
+    for (i = 0; i < NSUB; ++i)
+        if (Subp(p)[i] && isCell(Subp(p)[i])) nbShapeWalk((NBodyCell*) Subp(p)[i], out);
+}
+static void nbRecordShape(NBodyTree* t, unsigned char** shape)
+{
+    unsigned char* cursor;
+    if (!shape) return;
+    *shape = cursor = mwMalloc(t->cellUsed);
+    nbShapeWalk(t->root, &cursor);
+}
+#endif

