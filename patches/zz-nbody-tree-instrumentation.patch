+static int nbCountBalanced(NBodyNode* node, real size, int depth, int limit,
+                           int fixed, NBBalanceCounts* out)
+{
+    int count = 0, oct, before = out->used, top = out->top;
+    unsigned long visits = out->visits;
+    if (!isCell(node)) return 1;
+    for (oct = 0; oct < NSUB; ++oct) if (Subp(node)[oct])
+        count += nbCountBalanced(Subp(node)[oct], size * 0.5,
+                                 depth + 1, limit, fixed, out);
+    if ((fixed && depth == NB_TREE_DEPTH) ||
+        (!fixed && (count <= limit || size <= REAL_EPSILON))) {
+        out->used = before;
+        out->jobs[out->used++] = count;
+        out->top = top; out->visits = visits;
+    } else if (!fixed || depth < NB_TREE_DEPTH) {
+        ++out->top; out->visits += count;
+    }
+    return count;
+}
