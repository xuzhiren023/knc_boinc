+#if NBODY_TREE_IDENTITY
+static void nbIdentityFail(unsigned step, const char* field)
+{
+    mw_fail("TREE_IDENTITY step=%u mismatch: %s\n", step, field);
+}
+
+/* Address-independent preorder IDs compare topology after Quad has
+ * overwritten Subp. Next encodes subtree boundaries; More the first child. */
+static void nbCompareTrees(const NBodyCtx* ctx, NBodyState* st, NBodyState* serial)
+{
+    size_t count = st->tree.cellUsed + st->nbody, n = 0, i;
+    NBodyNode** a = mwMalloc(count * sizeof(*a));
+    NBodyNode** b = mwMalloc(count * sizeof(*b));
+    NBodyNode* p = (NBodyNode*) st->tree.root;
+    NBodyNode* q = (NBodyNode*) serial->tree.root;
+    if (st->tree.cellUsed != serial->tree.cellUsed || st->tree.maxDepth != serial->tree.maxDepth ||
+        st->tree.structureError != serial->tree.structureError ||
+        memcmp(&st->tree.rsize, &serial->tree.rsize, sizeof(real)))
+        nbIdentityFail(st->step, "tree metadata");
+    while (p && q && n < count)
+    {
+        a[n] = p; b[n++] = q;
+        if (Type(p) != Type(q)) nbIdentityFail(st->step, "shape/type");
+        if (isCell(p))
+        {
+            if (memcmp(&X(Pos(p)), &X(Pos(q)), sizeof(real)) ||
+                memcmp(&Y(Pos(p)), &Y(Pos(q)), sizeof(real)) ||
+                memcmp(&Z(Pos(p)), &Z(Pos(q)), sizeof(real)) ||
+                memcmp(&Mass(p), &Mass(q), sizeof(real)) ||
+                memcmp(&Rcrit2(p), &Rcrit2(q), sizeof(real)) ||
+                (ctx->useQuad && memcmp(&Quad(p), &Quad(q), sizeof(NBodyQuadMatrix))))
+                nbIdentityFail(st->step, "cell Pos/Mass/Rcrit2/Quad bits");
+        }
+        else if ((Body*) p - st->bodytab != (Body*) q - serial->bodytab)
+            nbIdentityFail(st->step, "body walk order");
+        p = isCell(p) ? More(p) : Next(p);
+        q = isCell(q) ? More(q) : Next(q);
+    }
+    if (p || q) nbIdentityFail(st->step, "walk length");
+    {
+        size_t* stack = mwMalloc(n * sizeof(*stack));
+        size_t depth = 0;
+        for (i = 0; i < n; ++i)
+        {
+            while (depth && Next(a[stack[depth-1]]) == a[i])
+            {
+                if (Next(b[stack[depth-1]]) != b[i]) nbIdentityFail(st->step, "Next boundary");
+                --depth;
+            }
+            if (depth && Next(b[stack[depth-1]]) == b[i]) nbIdentityFail(st->step, "Next boundary");
+            if (isCell(a[i]))
+            {
+                if (i + 1 == n || More(a[i]) != a[i+1] || More(b[i]) != b[i+1])
+                    nbIdentityFail(st->step, "More");
+                stack[depth++] = i;
+            }
+            else if ((Next(a[i]) != (i+1 < n ? a[i+1] : NULL)) ||
+                     (Next(b[i]) != (i+1 < n ? b[i+1] : NULL)))
+                nbIdentityFail(st->step, "body Next");
+        }
+        while (depth)
+        {
+            i = stack[--depth];
+            if (Next(a[i]) || Next(b[i])) nbIdentityFail(st->step, "terminal Next");
+        }
+        free(stack);
+    }
+    fprintf(stderr, "TREE_IDENTITY step=%u cells=%u nodes=%lu PASS\n",
+            st->step, st->tree.cellUsed, (unsigned long) n);
+    free(a); free(b);
+}
+#endif
