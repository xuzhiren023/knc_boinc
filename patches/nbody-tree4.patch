+#if NBODY_TREE_VARIANT == 4
+static void nbParallelPartition(NBodyState* st)
+{
+    NBTreePool* pool = st->treePool;
+    NBPathGroup *groups = pool->pathGroups, *nextGroups = pool->pathNext;
+    NBPathTile* tiles = pool->pathTiles;
+    int limit = MAX(2, st->nbody / (4 * pool->threads));
+    int initialTiles = (st->nbody + NB_PATH_TILE - 1) / NB_PATH_TILE;
+    int active = 0, tileCount = 0, count = 0, i;
+    pool->frontierUsed = pool->topUsed = 0;
+#ifdef _OPENMP
+    #pragma omp parallel shared(groups, nextGroups, active, tileCount, count)
+#endif
+    {
+        int j;
+        /* Stable compaction excludes zero-mass bodies just as serial insertion
+         * does. Scratch slots belong to the original contiguous input tile. */
+#ifdef _OPENMP
+        #pragma omp for schedule(static)
+#endif
+        for (j = 0; j < initialTiles; ++j) {
+            int first = j * NB_PATH_TILE, k, used = 0;
+            int end = MIN(st->nbody, first + NB_PATH_TILE);
+            for (k = first; k < end; ++k)
+                if (Mass(st->bodytab + k) != 0.0)
+                    pool->scratch[first + used++] = st->bodytab + k;
+            tiles[j].count = used;
+        }
+#ifdef _OPENMP
+        #pragma omp single
+#endif
+        {
+            for (j = 0; j < initialTiles; ++j) {
+                tiles[j].first = count;
+                count += tiles[j].count;
+            }
+        }
+#ifdef _OPENMP
+        #pragma omp for schedule(static)
+#endif
+        for (j = 0; j < initialTiles; ++j)
+            memcpy(pool->bodies + tiles[j].first, pool->scratch + j * NB_PATH_TILE,
+                   tiles[j].count * sizeof(*pool->bodies));
+#ifdef _OPENMP
+        #pragma omp single
+#endif
+        {
+            NBTreeBucket b;
+            b.cell = st->tree.root; b.size = st->tree.rsize; b.depth = 0;
+            b.bodies = pool->bodies; b.count = count;
+            if (count <= limit || b.size <= REAL_EPSILON)
+                pool->frontier[pool->frontierUsed++] = b;
+            else { groups[0].bucket = b; active = 1; }
+        }
+        while (active) {
+#ifdef _OPENMP
+            #pragma omp single
+#endif
+            {
+                tileCount = 0;
+                for (j = 0; j < active; ++j) {
+                    NBPathGroup* g = groups + j;
+                    int first = (int) (g->bucket.bodies - pool->bodies), k;
+                    g->firstTile = tileCount;
+                    for (k = 0; k < g->bucket.count; k += NB_PATH_TILE) {
+                        NBPathTile* tile = tiles + tileCount++;
+                        tile->group = j; tile->first = first + k;
+                        tile->count = MIN(NB_PATH_TILE, g->bucket.count - k);
+                    }
+                    g->endTile = tileCount;
+                }
+            }
+#ifdef _OPENMP
+            #pragma omp for schedule(static)
+#endif
+            for (j = 0; j < tileCount; ++j) {
+                NBPathTile* tile = tiles + j;
+                NBodyCell* cell = groups[tile->group].bucket.cell;
+                int k, oct;
+                for (oct = 0; oct < NSUB; ++oct) tile->next[oct] = 0;
+                for (k = tile->first; k < tile->first + tile->count; ++k) {
+                    oct = nbSubIndex(pool->bodies[k], cell);
+                    pool->keys[k] = (unsigned short) oct;
+                    ++tile->next[oct];
+                }
+            }
+#ifdef _OPENMP
+            #pragma omp for schedule(static)
+#endif
+            for (j = 0; j < active; ++j) {
+                NBPathGroup* g = groups + j;
+                int oct, t, offset = (int) (g->bucket.bodies - pool->bodies);
+                for (oct = 0; oct < NSUB; ++oct) {
+                    g->offsets[oct] = offset;
+                    for (t = g->firstTile; t < g->endTile; ++t) {
+                        int n = tiles[t].next[oct];
+                        tiles[t].next[oct] = offset; offset += n;
+                    }
+                }
+                g->offsets[NSUB] = offset;
+            }
+#ifdef _OPENMP
+            #pragma omp for schedule(static)
+#endif
+            for (j = 0; j < tileCount; ++j) {
+                NBPathTile* tile = tiles + j;
+                int k;
+                for (k = tile->first; k < tile->first + tile->count; ++k)
+                    pool->scratch[tile->next[pool->keys[k]]++] = pool->bodies[k];
+            }
+#ifdef _OPENMP
+            #pragma omp for schedule(static)
+#endif
+            for (j = 0; j < tileCount; ++j)
+                memcpy(pool->bodies + tiles[j].first, pool->scratch + tiles[j].first,
+                       tiles[j].count * sizeof(*pool->bodies));
+#ifdef _OPENMP
+            #pragma omp single
+#endif
+            {
+                int nextUsed = 0;
+                for (j = 0; j < active; ++j) {
+                    NBPathGroup* g = groups + j;
+                    NBTreeBucket b = g->bucket;
+                    int oct;
+                    /* Append parents in breadth order, then reverse below.
+                     * Only parent/child order matters between upper cells;
+                     * each individual moment still sums in octant order. */
+                    if ((size_t) pool->topUsed == pool->topCapacity) {
+                        size_t capacity = pool->topCapacity ? 2 * pool->topCapacity : 128;
+                        NBTreeBucket* top = nbTreeAlloc(capacity * sizeof(*top), 0);
+                        if (pool->topUsed) memcpy(top, pool->top, pool->topUsed * sizeof(*top));
+                        free(pool->top); pool->top = top; pool->topCapacity = capacity;
+                    }
+                    pool->top[pool->topUsed++] = b;
+                    for (oct = 0; oct < NSUB; ++oct) {
+                        int first = g->offsets[oct];
+                        int n = g->offsets[oct + 1] - first;
+                        if (n == 1) {
+                            Subp(b.cell)[oct] = (NBodyNode*) pool->bodies[first];
+                            st->tree.maxDepth = MAX(st->tree.maxDepth, b.depth);
+                        } else if (n > 1) {
+                            NBTreeBucket child;
+                            child.cell = nbMakeCell(st, &st->tree);
+                            nbInitMidpoint(child.cell, pool->bodies[first], b.cell, b.size);
+                            Subp(b.cell)[oct] = (NBodyNode*) child.cell;
+                            child.size = b.size * 0.5; child.depth = b.depth + 1;
+                            child.bodies = pool->bodies + first; child.count = n;
+                            if (n <= limit || child.size <= REAL_EPSILON)
+                                pool->frontier[pool->frontierUsed++] = child;
+                            else nextGroups[nextUsed++].bucket = child;
+                        }
+                    }
+                }
+                { NBPathGroup* swap = groups; groups = nextGroups; nextGroups = swap; }
+                active = nextUsed;
+            }
+        }
+    }
+    for (i = 0; i < pool->topUsed / 2; ++i) {
+        NBTreeBucket swap = pool->top[i];
+        pool->top[i] = pool->top[pool->topUsed - 1 - i];
+        pool->top[pool->topUsed - 1 - i] = swap;
+    }
+    qsort(pool->frontier, pool->frontierUsed, sizeof(*pool->frontier), nbBiggestFirst);
+}
+#endif
