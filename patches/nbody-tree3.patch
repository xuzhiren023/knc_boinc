+/* Four jobs per thread trade serial top work against tail imbalance. Each
+ * stable scatter retains original body order. Midpoints use nbInitMidpoint,
+ * including repeated rounding, exactly as serial collision insertion does. */
+#if NBODY_TREE_VARIANT == 3
+static void nbBalancedSplit(NBodyState* st, NBodyCell* cell, real size,
+                            unsigned depth, Body** bodies, Body** scratch,
+                            int count, int limit)
+{
+    NBTreePool* pool = st->treePool;
+    int counts[NSUB] = {0}, offsets[NSUB + 1], next[NSUB], i, oct;
+    NBTreeBucket b;
+    b.cell = cell; b.size = size; b.depth = depth;
+    b.bodies = bodies; b.count = count;
+    if (count <= limit || size <= REAL_EPSILON) {
+        pool->frontier[pool->frontierUsed++] = b;
+        return;
+    }
+    for (i = 0; i < count; ++i) ++counts[nbSubIndex(bodies[i], cell)];
+    offsets[0] = 0;
+    for (oct = 0; oct < NSUB; ++oct) {
+        next[oct] = offsets[oct];
+        offsets[oct + 1] = offsets[oct] + counts[oct];
+    }
+    for (i = 0; i < count; ++i) {
+        oct = nbSubIndex(bodies[i], cell);
+        scratch[next[oct]++] = bodies[i];
+    }
+    memcpy(bodies, scratch, count * sizeof(*bodies));
+    for (oct = 0; oct < NSUB; ++oct) {
+        int first = offsets[oct];
+        if (counts[oct] == 1) {
+            Subp(cell)[oct] = (NBodyNode*) bodies[first];
+            st->tree.maxDepth = MAX(st->tree.maxDepth, depth);
+        } else if (counts[oct] > 1) {
+            NBodyCell* child = nbMakeCell(st, &st->tree);
+            nbInitMidpoint(child, bodies[first], cell, size);
+            Subp(cell)[oct] = (NBodyNode*) child;
+            nbBalancedSplit(st, child, size * 0.5, depth + 1,
+                            bodies + first, scratch + first, counts[oct], limit);
+        }
+    }
+    /* Postorder permits serial parents to consume completed frontier moments.
+     * Grow only on the serial path; no concurrent reallocations or pointers
+     * into this array survive an append. Retain scratch between builds. */
+    if ((size_t) pool->topUsed == pool->topCapacity) {
+        size_t capacity = pool->topCapacity ? 2 * pool->topCapacity : 128;
+        NBTreeBucket* top = nbTreeAlloc(capacity * sizeof(*top), 0);
+        if (pool->topUsed) memcpy(top, pool->top, pool->topUsed * sizeof(*top));
+        free(pool->top); pool->top = top; pool->topCapacity = capacity;
+    }
+    pool->top[pool->topUsed++] = b;
+}
+
+static int nbBiggestFirst(const void* a, const void* b)
+{
+    int na = ((const NBTreeBucket*) a)->count;
+    int nb = ((const NBTreeBucket*) b)->count;
+    return (na < nb) - (na > nb);
+}
+
+static void nbBalancedPartition(NBodyState* st)
+{
+    NBTreePool* pool = st->treePool;
+    int i, count = 0;
+    int limit = MAX(2, st->nbody / (4 * pool->threads));
+    pool->frontierUsed = pool->topUsed = 0;
+    for (i = 0; i < st->nbody; ++i)
+        if (Mass(st->bodytab + i) != 0.0) pool->bodies[count++] = st->bodytab + i;
+    nbBalancedSplit(st, st->tree.root, st->tree.rsize, 0,
+                    pool->bodies, pool->scratch, count, limit);
+    qsort(pool->frontier, pool->frontierUsed, sizeof(*pool->frontier), nbBiggestFirst);
+}
+
+static void nbBalancedMoments(const NBodyCtx* ctx, NBodyTree* t, NBTreePool* pool)
+{
+    int i, error = 0;
+#ifdef _OPENMP
+    #pragma omp parallel for schedule(dynamic, 1) reduction(|:error)
+#endif
+    for (i = 0; i < pool->frontierUsed; ++i) {
+        NBodyTree local = *t;
+        NBTreeBucket* b = pool->frontier + i;
+        hackCofMTo(ctx, &local, b->cell, b->size, -1);
+        error |= local.structureError;
+    }
+    t->structureError |= error;
+    for (i = 0; i < pool->topUsed; ++i)
+        hackCofMTo(ctx, t, pool->top[i].cell, pool->top[i].size, 0);
+}
+
+static void nbBalancedThread(NBTreePool* pool)
+{
+    int i;
+#ifdef _OPENMP
+    #pragma omp parallel for schedule(dynamic, 1)
+#endif
+    for (i = 0; i < pool->frontierUsed; ++i)
+        threadTree((NBodyNode*) pool->frontier[i].cell, NULL);
+    /* Reverse postorder: a parent supplies each top child's successor before
+     * that child is processed. No frontier interior is touched here. */
+    Next(pool->cells) = NULL;
+    for (i = pool->topUsed; i-- > 0;) {
+        NBodyCell* cell = pool->top[i].cell;
+        NBodyNode* next = Next(cell);
+        int oct;
+        for (oct = NSUB; oct-- > 0;) if (Subp(cell)[oct]) {
+            Next(Subp(cell)[oct]) = next;
+            next = Subp(cell)[oct];
+        }
+        More(cell) = next;
+    }
+    /* Local NULL successors occur exactly on the final child's spine.
+     * Patch all of them to the external successor (not just the last body).
+     * Subp remains live until quadrupoles, so no walk or address map is needed. */
+    for (i = 0; i < pool->frontierUsed; ++i) {
+        NBodyNode* node = (NBodyNode*) pool->frontier[i].cell;
+        NBodyNode* next = Next(node);
+        while (isCell(node)) {
+            int oct = NSUB;
+            while (oct && !Subp(node)[oct - 1]) --oct;
+            if (!oct) break;
+            node = Subp(node)[oct - 1];
+            Next(node) = next;
+        }
+    }
+}
+
+static void nbBalancedQuads(NBTreePool* pool)
+{
+    int i;
+#ifdef _OPENMP
+    #pragma omp parallel for schedule(dynamic, 1)
+#endif
+    for (i = 0; i < pool->frontierUsed; ++i) hackQuadTo(pool->frontier[i].cell, -1);
+    for (i = 0; i < pool->topUsed; ++i) hackQuadTo(pool->top[i].cell, 0);
+}
+#endif
