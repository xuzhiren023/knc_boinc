@@ -0,0 +1,31 @@
+/* Optional wall-clock accounting; all calls are on the controlling thread.
+ * Phase times overlap setup (initial gravity); do not sum them as a total. */
+#ifndef NBODY_PHASE_TIMERS_H
+#define NBODY_PHASE_TIMERS_H
+#ifndef NBODY_PHASE_TIMERS
+#define NBODY_PHASE_TIMERS 0
+#endif
+enum NBPhase { NB_TREE, NB_FORCE, NB_POSVEL, NB_VEL, NB_LIKE, NB_FINAL,
+               NB_SETUP, NB_STEPS, NB_WHOLE,
+               NB_TREE_NEW, NB_TREE_EXPAND, NB_TREE_PARTITION, NB_TREE_INSERT,
+               NB_TREE_COFM, NB_TREE_THREAD, NB_TREE_QUAD, NB_TREE_MALLOC,
+               NB_TREE_BYTES, NB_PHASE_COUNT };
+#if NBODY_PHASE_TIMERS
+#include <omp.h>
+extern double nbPhaseSeconds[NB_PHASE_COUNT];
+extern unsigned long nbPhaseCalls[NB_PHASE_COUNT];
+extern double nbPhaseStart;
+#define NB_PHASE(id, statement) do { \
+    double nb_phase_t0 = omp_get_wtime(); \
+    statement; \
+    nbPhaseSeconds[id] += omp_get_wtime() - nb_phase_t0; \
+    ++nbPhaseCalls[id]; \
+    } while (0)
+#define NB_STEP() (++nbPhaseCalls[NB_STEPS])
+void nbPhaseSetupDone(void);
+#else
+#define NB_PHASE(id, statement) do { statement; } while (0)
+#define NB_STEP() ((void) 0)
+#define nbPhaseSetupDone() ((void) 0)
+#endif
+#endif
