# S10 combined release. Source defaults remain opt-in.
# Owner 2026-11-17: release adopts the S10-10 batched 8-lane star setup (libknc_vmath exp/pow, exact scalar
# log/atan, guard margin from S10-09). Exactness is measured, not proven: identical likelihoods on core-small,
# real-steps and the full 117676 on the card.
export OPTFLAGS=-O2
export TREE_VARIANT=4
export DF_REUSE=1
export DF_SPECIAL=1
export DF_VMATH=0
export DF_BATCH=1
export DF_VECTOR8=1
export DF_VECTOR8_GUARD=1
export DF_VECTOR8_SCALAR_LOG_ATAN=1
export PARALLEL_QUAD=1
export STATIC_INTEGRATE=1
export FORCE_CHUNK=4
export VECTOR_GRAVITY=0
export WALK_LAYOUT=0
export PHASE_TIMERS=0
export TREE_IDENTITY=0
export WALK_COUNTERS=0
export DF_VECTOR=0
export DF_STATS=0
export DF_SOURCE=
export PGOFLAGS=
export DF_VECTOR8_MARGIN=6.7163549441806109e-08
