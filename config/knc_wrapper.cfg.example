# Put knc_wrapper.cfg in the BOINC slot or beside knc_wrapper.exe.
host=mic0
user=REPLACE_ME
ssh_key=C:/Users/REPLACE_ME/.ssh/card_key
ssh_path=C:/Windows/System32/OpenSSH/ssh.exe
scp_path=C:/Windows/System32/OpenSSH/scp.exe
remote_base=/tmp/knc-boinc
# Relative to this config file; contents of dist/card from make -C mk card.
package_dir=card
app=milkyway_nbody.mic
OMP_NUM_THREADS=240
poll_interval=10
# Snapshot production/download cadence in wall seconds.
snapshot_interval=5
connect_timeout=10
retry_limit=3
checkpoint_timeout=60
bodies=64
# Periodic card checkpoint cadence in seconds (task argv overrides this default).
checkpoint_interval=120
# Shared turn ledger; leave enabled for real BOINC tasks.
card_booking=1
booking_ledger=C:/Users/xuzhi/Documents/card-coordination/jobs.jsonl
dma_stop_latch=C:/Users/xuzhi/Documents/gcc_knc/.work/_state/card-dma-active.lock
# Release the turn after this many seconds suspended; resume requeues.
booking_suspend_timeout=300
