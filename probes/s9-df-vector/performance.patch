+static inline DfBall df_neg(DfBall a) { a.v = -a.v; return a; }
+static inline DfBall df_sub(DfBall a, DfBall b) { return df_add(a,df_neg(b)); }
+static inline DfBall df_mul(DfBall a, DfBall b)
