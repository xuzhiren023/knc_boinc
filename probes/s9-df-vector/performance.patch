+    DfV v = a.v*b.v, t = df_abs(a.v)*b.e + df_abs(b.v)*a.e + a.e*b.e;
+    return df_ball(v, df_inflate(t + df_v(4*DBL_EPSILON)*(df_abs(v)+t)));
