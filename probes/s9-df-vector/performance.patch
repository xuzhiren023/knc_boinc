+static inline DfV df_inflate(DfV a)
+{ return a * df_v(1 + 32 * DBL_EPSILON) + df_v(32 * DBL_MIN); }
+static inline DfBall df_ball(DfV v, DfV e)
+{
+    for(int i=0;i<8;++i)
+        if(!isfinite(v[i]) || !isfinite(e[i]) || e[i]<0 ||
+           !isfinite(fabs(v[i])+e[i])) e[i]=INFINITY;
