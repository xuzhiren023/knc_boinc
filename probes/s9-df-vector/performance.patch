+typedef double DfV __attribute__((vector_size(64)));
+typedef long long DfI __attribute__((vector_size(64)));
+typedef struct { DfV v, e; } DfBall;
+static inline DfV df_v(real a) { return (DfV){a,a,a,a,a,a,a,a}; }
+static inline DfV df_abs(DfV a)
+{
+    union { DfV d; DfI i; } u;
+    u.d = a; u.i &= (DfI){0x7fffffffffffffffLL,0x7fffffffffffffffLL,
+        0x7fffffffffffffffLL,0x7fffffffffffffffLL,0x7fffffffffffffffLL,
+        0x7fffffffffffffffLL,0x7fffffffffffffffLL,0x7fffffffffffffffLL};
+    return u.d;
