+    /* The cored cutoff uses incomplete gamma; those lanes are evaluated by
+     * the unmodified scalar sampler below, with zero discrepancy. */
+    DfBall rc=df_const(m->rc), p0=df_const(m->p0), ps=df_const(m->ps);
+    DfBall diff=df_sub(df_const(m->m_iso_r1),df_const(m->m_nfw_r1));
+    DfBall core=df_mul(df_mul(df_mul(df_neg(fourpi),p0),df_sqr(rc)),
+        df_add(df_mul(df_log(df_add(df_sqr(rc),df_sqr(r))),df_inv(df_const(2))),
+               df_mul(df_mul(rc,df_atan(df_div(r,rc))),df_inv(r))));
+    core=df_add(df_add(df_sub(core,df_const(m->psi_iso_r1)),df_const(m->psi_nfw_r1)),df_mul(diff,df_inv(df_const(m->r1))));
+    DfBall outer=df_add(df_mul(df_mul(df_mul(df_mul(fourpi,ps),df_cube(rs)),df_inv(r)),
+                          df_log(df_add(one,df_div(r,rs)))),df_mul(diff,df_inv(r)));
+    DfBall coreden=df_div(p0,df_add(one,df_sqr(df_div(r,rc))));
+    DfBall outerden=df_div(ps,df_mul(df_div(r,rs),df_sqr(df_add(one,df_div(r,rs)))));
+    *pot=outer; *den=outerden;
+    for(int i=0;i<8;++i) if(radii[i]<=m->r1)
+    { pot->v[i]=core.v[i]; pot->e[i]=core.e[i]; den->v[i]=coreden.v[i]; den->e[i]=coreden.e[i]; }
+    if(m->rcut!=0)
+    {
+        DfBall invcut=df_inv(df_const(m->rcut));
+        DfBall offset=df_add(df_add(df_sub(df_neg(df_const(m->psi_nfw_cut)),df_mul(diff,invcut)),
+            df_const(m->psi_cut_cut)),df_mul(df_sub(df_add(df_const(m->m_nfw_cut),df_const(m->m_iso_r1)),df_const(m->m_nfw_r1)),invcut));
+        *pot=df_add(*pot,offset);
+    }
+    for(int i=0;i<8;++i) if(radii[i]<=0 || (m->rcut!=0 && radii[i]>m->rcut))
+    {
+        pot->v[i]=get_potential(m,radii[i]); pot->e[i]=0;
+        den->v[i]=get_density(m,radii[i]); den->e[i]=0;
+    }
+}
+static void df_pair(DfBall* f, DfBall* first, DfBall* second)
+{
+    /* mm,m,pp,p,center; reciprocal constants match the upstream double graph. */
+    *first=df_mul(df_add(df_add(df_add(df_mul(df_const(1),f[0]),df_mul(df_const(-8),f[1])),
+                   df_mul(df_const(-1),f[2])),df_mul(df_const(8),f[3])),df_const(1.0/(12.0*0.001)));
+    *second=df_mul(df_add(df_add(df_add(df_add(df_mul(df_const(-1),f[2]),df_mul(df_const(16),f[3])),
+                   df_mul(df_const(-30),f[4])),df_mul(df_const(16),f[1])),df_mul(df_const(-1),f[0])),df_const(1.0/(12.0*0.001*0.001)));
+}
+static void df_nodes8(const real* x, size_t n, const Dwarf* a, const Dwarf* b,
+                       real energy, mwbool dark, real* values, real* errors)
+{
+    DfBall ap[5],ad[5],bp[5],bd[5];
+    const real shifts[5]={-2.0*0.001,-0.001,2.0*0.001,0.001,0};
+    for(int k=0;k<5;++k)
+    {
+        DfV r;
+        for(int i=0;i<8;++i) r[i]=x[i<(int)n ? i:0]+shifts[k];
+        df_samples(a,r,&ap[k],&ad[k]); df_samples(b,r,&bp[k],&bd[k]);
+    }
+    DfBall af,as,bf,bs,dr,ds;
+    df_pair(ap,&af,&as); df_pair(bp,&bf,&bs); df_pair(dark?bd:ad,&dr,&ds);
+    DfBall pf=df_add(af,bf), ps=df_add(as,bs);
+    /* A zero-containing first derivative or energy difference replays; no
+     * attempt to approximate the reference's zero-substitution branches. */
+    DfBall diff=df_fabs(df_sub(df_const(energy),df_add(ap[4],bp[4])));
+    DfBall result=df_mul(df_sub(df_mul(ds,df_inv(pf)),df_mul(df_mul(dr,ps),df_inv(df_sqr(pf)))),df_inv(df_sqrt(diff)));
+    for(size_t i=0;i<n;++i)
+    {
+        values[i]=result.v[i]; errors[i]=result.e[i];
+        if(!isfinite(values[i]) || !isfinite(errors[i]) || errors[i]<0 ||
+           !(fabs(pf.v[i])>pf.e[i]) || !(diff.v[i]>diff.e[i])) errors[i]=INFINITY;
+    }
+}
